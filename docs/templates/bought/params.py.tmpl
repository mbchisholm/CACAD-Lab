"""$name: one line on what is built and from what stock.

Every number is a (value, TAG, source) triple. STANDARD and VENDOR name the
document; DESIGN is this model's choice; UNVERIFIED is an estimate and never
excuses a validate() failure. Rules: docs/PARAMS_CONVENTION.md.

    .venv/bin/python projects/$name/params.py      # prints the design and cut list
"""
from __future__ import annotations

STATUS = "concept"   # concept | passes | printed | parked

IN = 25.4

STOCK = {
    # name: (length mm, TAG, source)
    "board_1x4": (96 * IN, "VENDOR", "retailer catalogue page, nominal 1x4 x 8 ft"),
}

DESIGN = {
    "length": (48 * IN, "DESIGN", "chosen finished length"),
}


def derive() -> dict:
    d = {k: v[0] for k, v in {**STOCK, **DESIGN}.items()}
    d["pieces_per_board"] = int(d["board_1x4"] // d["length"])
    return d


def validate() -> dict:
    d = derive()
    for table in (STOCK, DESIGN):
        for k, (_, tag, src) in table.items():
            assert tag and src, f"{k}: every number needs a tag and a source"
    assert d["pieces_per_board"] >= 1, "finished length is longer than the stock"
    assert STATUS in ("concept", "passes", "printed", "parked"), f"STATUS {STATUS!r} not recognised"
    return d


if __name__ == "__main__":
    d = validate()
    print(f"{d['pieces_per_board']} piece(s) of {d['length'] / IN:.1f} in per board")
